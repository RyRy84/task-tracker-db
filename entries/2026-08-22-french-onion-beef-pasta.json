  "ingredients": [
    "1 lb ground beef",
    "6–8 pappardelle pasta nests",
    "1 onion, sliced",
    "1 tbsp butter",
    "1 packet onion soup mix",
    "3 cups beef broth",
    "1 tbsp Worcestershire sauce",
    "1/2 cup heavy cream",
    "1/2 cup shredded Swiss or Gruyère"
  ],
  "instructions": [
    "Brown beef; remove from pan.",
    "Add butter and onion to the pan and cook until soft.",
    "Add onion soup mix, beef broth, and Worcestershire sauce.",
    "Add pasta nests. Cover and simmer 8–12 minutes, gently separating the noodles as they soften.",
    "Stir the beef back in along with the cream and cheese.",
    "Simmer 2–3 minutes until creamy."
  ],
  "notes": "One-pot meal. Creator: Chaley Jo Meeker.",
